# ==============================
# 纯 C++ 部署端专用 .gitignore
# ==============================

# 1. 编译产物
build/
cmake-build-*/
*.o
*.obj
*.so
*.a

# 2. 模型文件 (Engine 通常非常大，且与硬件绑定，不建议入 Git)
*.engine
*.plan

# 3. 本地第三方静态依赖库
third_party/

# 4. IDE 配置 (彻底忽略所有编辑器配置)
.vscode/
.idea/
*.swp

# 5. 测试运行输出产物
output*.jpg
*_result.jpg
*.log

# 6. Python 缓存 (针对 trt_python 目录)
__pycache__/
*.pyc