# ==============================
# 纯 C++ 部署端专用 .gitignore
# ==============================

# 1. 编译产物
build/
cmake-build-*/
*.o
*.obj
*.so
*.a

# 2. 模型文件 (Engine 通常非常大，且与硬件绑定，不建议入 Git)
*.engine
*.plan
# 如果你想把 onnx 也传上去供别人转换，可以保留；如果也不想传，就加上 *.onnx

# 3. 本地第三方静态依赖库
third_party/

# 4. IDE 配置 (只保留推荐的插件和属性配置)
.vscode/*
!.vscode/c_cpp_properties.json
!.vscode/extensions.json
.idea/
*.swp

# 5. 测试运行输出产物
output*.jpg
*_result.jpg
*.log