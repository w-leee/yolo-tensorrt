# ==========================================
# 标准 C++ / TensorRT 部署端 .gitignore
# ==========================================

# 1. C++ 编译产物 (虽未显示在树中，但已忽略)
build/
cmake-build-*/
*.o
*.so
*.a

# 2. 模型文件 (体积大且需硬件专属编译，由算法端或本地提供)
*.onnx
*.engine
*.plan
*.trt
*.pt

# 3. 第三方依赖库
third_party/

# 4. IDE 与编辑器配置
.vscode/
.idea/

# 5. 运行测试的输出文件
output*.jpg
*_result.jpg

# 6. Python 运行缓存 (针对 trt_python 目录)
__pycache__/
*.py[cod]

# 7. 系统临时文件
.DS_Store
Thumbs.db
